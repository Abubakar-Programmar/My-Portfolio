# ─────────────────────────────────────────────────────────────
# Database (PostgreSQL). The app creates and uses its own "portfolio" schema, so it can
# safely share a database with other applications. Extra query params such as
# ?connection_limit=10 are ignored.
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE"

# ─────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────
# Public URL of the site. Used for canonical URLs, the sitemap, RSS and links inside emails.
# Must match the port you run on (e.g. http://localhost:3000 in dev, https://yourdomain.com in production).
APP_URL="http://localhost:3000"

# Secret used to seal the admin session cookie. At least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NUXT_SESSION_PASSWORD="replace-with-at-least-32-random-characters"

# Where uploaded media is stored. Keep it OUTSIDE the build output (and back it up).
# Relative paths resolve from the project root.
UPLOADS_DIR="./uploads"

# ─────────────────────────────────────────────────────────────
# Admin account (single admin). Read by `pnpm db:seed`.
# If ADMIN_PASSWORD is missing the seed generates a strong one and writes it to .env.
# ─────────────────────────────────────────────────────────────
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-long-unique-password"

# Optional: where owner notifications are emailed. Can also be changed in
# Admin → Site settings → Notifications. Defaults to ADMIN_EMAIL.
NOTIFY_EMAIL=""

# ─────────────────────────────────────────────────────────────
# Outgoing email (SMTP) — contact notifications, replies, password reset, weekly summary
# ─────────────────────────────────────────────────────────────
MAIL_MAILER="smtp"
MAIL_HOST="smtp.example.com"
MAIL_PORT=587
# "tls" = STARTTLS (port 587), "ssl" = implicit TLS (port 465)
MAIL_ENCRYPTION="tls"
MAIL_USERNAME="smtp-username"
MAIL_PASSWORD="smtp-password"
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="Your Name"
